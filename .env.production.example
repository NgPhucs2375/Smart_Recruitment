# Placeholder biến môi trường PRODUCTION cho Render — KHÔNG chứa credentials thật.
# Copy tên biến sang Render Dashboard (Environment) và điền giá trị thật ở đó.
# File này được commit; KHÔNG bao giờ điền secret thật vào đây.

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production
# PORT do Render tự cấp — KHÔNG set tay. Local fallback 8080 (backend) / 3000 (frontend).

# --- PostgreSQL (Render managed, project hireai) ---
# Ưu tiên 1 trong 2. Thêm Ssl Mode=Require khi Render bắt SSL.
ConnectionStrings__PostgresConnection=
# POSTGRES_CONNECTION_STRING=

# --- JWT (Key phải là Base64 decode >= 32 bytes, tự sinh mới, lưu Secret) ---
JWTSettings__Key=
JWTSettings__Issuer=
JWTSettings__Audience=
JWTSettings__DurationInMinutes=60

# --- Seed admin một lần (xem docs/render-deployment.md mục 9) ---
# Mặc định TẮT. Chỉ bật (=true) cho lần deploy đầu cần tạo admin, kèm email + password mạnh,
# sau đó TẮT lại và đổi/xóa password theo quy trình vận hành.
Seed__EnableDefaultUsers=false
Seed__AdminEmail=
Seed__AdminUserName=
Seed__AdminPassword=
# Mật khẩu tài khoản demo basicuser (chỉ có tác dụng khi EnableDefaultUsers=true).
Seed__BasicUserPassword=

# --- CORS prod (bắt buộc, phân tách bằng ';', KHÔNG dùng *) ---
Frontend__AllowedOrigins=

# --- AI ---
# Groq: dùng 1 trong 2 tên (ưu tiên Groq__ApiKey).
Groq__ApiKey=
# GROQ_API_KEY=
Gemini__ApiKey=
Gemini__Model=gemini-2.5-flash

# --- Object storage S3-compatible (MinIO SDK, KHÔNG hardcode localhost ở prod) ---
# MinIO tự host: Endpoint nội bộ Render truy cập được; PublicEndpoint là URL HTTPS public cho browser.
# S3-compatible ngoài: Endpoint/PublicEndpoint theo nhà cung cấp, UseSSL=true.
Minio__Endpoint=
Minio__PublicEndpoint=
Minio__AccessKey=
Minio__SecretKey=
Minio__BucketName=smart-recruitment-files
Minio__UseSSL=true

# --- Mail (tùy chọn, nếu dùng gửi mail) ---
MailSettings__SmtpHost=
MailSettings__SmtpPort=
MailSettings__SmtpUser=
MailSettings__SmtpPass=
MailSettings__EmailFrom=
MailSettings__DisplayName=

# --- Google login (tùy chọn) ---
GoogleSettings__ClientId=

# --- Frontend (Render Web Service, server-only trừ NEXT_PUBLIC_*) ---
DOTNET_API_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
