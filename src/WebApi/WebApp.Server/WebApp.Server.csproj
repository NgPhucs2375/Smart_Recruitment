    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Novell.Directory.Ldap.NETStandard" Version="4.0.0" />
    <PackageReference Include="NCrontab.Signed" Version="3.3.3" />
