{
  "expo": {
    "name": "HIREAI",
    "slug": "smart-recruitment-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartrecruitment",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.smartrecruitment.mobile",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.smartrecruitment.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#f7f3ec",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f3ec",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "HIREAI cần truy cập thư viện ảnh để cập nhật ảnh đại diện."
        }
      ],
      "./plugins/with-google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "19dd47d9-d6d7-492f-b249-426d1cb88390"
      }
    }
  }
}
