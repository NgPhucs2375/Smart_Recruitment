# Android emulator + local Docker Compose (default frontend port is 3001; check `docker compose ps`):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/dotnet
# Deployed Next.js proxy:
# EXPO_PUBLIC_API_URL=https://your-domain.example/api/dotnet

# Local development uses sample jobs by default; set false to call the API.
# Mock mode is disabled automatically in production builds.
EXPO_PUBLIC_USE_MOCK_DATA=true
EXPO_PUBLIC_API_URL=

# Optional: SignalR hub URL. Để trống để tự suy ra từ EXPO_PUBLIC_API_URL.
# Ví dụ: https://your-domain.example/api/hubs/notifications
EXPO_PUBLIC_SIGNALR_URL=

# Google OAuth: Web client ID must match GoogleSettings__ClientId on the server.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# GitHub OAuth App callback URL must match EXPO_PUBLIC_GITHUB_REDIRECT_URI exactly.
EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_GITHUB_REDIRECT_URI=
