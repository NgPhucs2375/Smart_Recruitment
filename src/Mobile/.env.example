# Android emulator + local Docker Compose (adjust port to `docker compose ps`):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/dotnet
# Deployed Next.js proxy:
# EXPO_PUBLIC_API_URL=https://your-domain.example/api/dotnet

# Local development uses sample jobs by default; set false to call the API.
# Mock mode is disabled automatically in production builds.
EXPO_PUBLIC_USE_MOCK_DATA=true
EXPO_PUBLIC_API_URL=
